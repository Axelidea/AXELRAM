\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Processing flow comparison. Conventional (top): GPU computes K,V, quantizes in software, stores to HBM, reads back with software dequantization---$d \times T$ multiplications per query. AXELRAM (bottom): single-step write (Hadamard + quantize + SRAM store) and single-step read (table lookup + add)---1 multiplication per key, on-chip SRAM only.}}{1}{figure.1}\protected@file@percent }
\newlabel{fig:comparison}{{1}{1}{Processing flow comparison. Conventional (top): GPU computes K,V, quantizes in software, stores to HBM, reads back with software dequantization---$d \times T$ multiplications per query. AXELRAM (bottom): single-step write (Hadamard + quantize + SRAM store) and single-step read (table lookup + add)---1 multiplication per key, on-chip SRAM only}{figure.1}{}}
