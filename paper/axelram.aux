\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {III-A}}Write Path (Zero Multipliers)}{1}{subsection.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces AXELRAM smart SRAM macro. \textbf  {Write path} (left): norm extraction, FWHT butterfly network (448 add/sub, zero multipliers), Lloyd-Max comparator quantization (896 comparators), writing 3-bit indices + FP16 norm to SRAM. \textbf  {Read path} (right): pre-computed table lookup (128 parallel reads), adder tree (127 adders), norm scaling (1 multiplication). \textbf  {Pre-computation} (top center, once per query): table generation with 1024 multiplications. The fixed codebook ROM (30 bytes) is shared by both paths across all $d{=}128$ dimensions.}}{2}{figure.2}\protected@file@percent }
\newlabel{fig:macro}{{2}{2}{AXELRAM smart SRAM macro. \textbf {Write path} (left): norm extraction, FWHT butterfly network (448 add/sub, zero multipliers), Lloyd-Max comparator quantization (896 comparators), writing 3-bit indices + FP16 norm to SRAM. \textbf {Read path} (right): pre-computed table lookup (128 parallel reads), adder tree (127 adders), norm scaling (1 multiplication). \textbf {Pre-computation} (top center, once per query): table generation with 1024 multiplications. The fixed codebook ROM (30 bytes) is shared by both paths across all $d{=}128$ dimensions}{figure.2}{}}
